# ─── Servidor ─────────────────────────────────────────────────
PORT=3000

# ─── WhatsApp ──────────────────────────────────────────────────
# Número do atendente que recebe notificações de novos tickets
# Formato: código do país + DDD + número (sem + nem espaços)
ATENDENTE_NUMBER=557999446813

# ─── Painel de Administração ───────────────────────────────────
# FIX: estas variáveis não eram usadas no código (auth usa JWT/bcrypt)
# Mantidas apenas para referência histórica — considere remover
PAINEL_USUARIO=admin
PAINEL_SENHA=coloque-uma-senha-forte-aqui

# ─── Segurança ─────────────────────────────────────────────────
# Token de autenticação da API externa. DEVE ser trocado antes de ir a produção!
API_TOKEN=troque-por-um-token-seguro-aqui

# Segredo do JWT (usado para autenticação do painel). Mínimo 32 caracteres.
JWT_SECRET=coloque-um-segredo-longo-e-aleatorio-aqui

# ─── Timezone e Horários ───────────────────────────────────────
# Timezone do negócio. Utilizado em horario.js E notificacao.service.js
# IMPORTANTE: usar esta variável em AMBOS os serviços (era TZ_ATENDIMENTO antes — corrigido)
TZ_NEGOCIO=America/Maceio

# Minutos antes de encerrar sessão por inatividade para enviar aviso
AVISO_MINUTOS=3
# Minutos totais de inatividade antes de encerrar a sessão
TIMEOUT_MINUTOS=5

# ─── Rate Limit (bot WhatsApp) ─────────────────────────────────
MAX_CHARS_INPUT=500
RATE_LIMIT_MAX=10
RATE_LIMIT_JANELA_MS=10000

# ─── Backups ───────────────────────────────────────────────────
# Quantidade máxima de pastas de backup retidas (as mais antigas são apagadas)
MAX_BACKUPS=30

# ─── Banco de Dados (PostgreSQL) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque-uma-senha-forte-aqui
DB_NAME=chatbot_rildon
