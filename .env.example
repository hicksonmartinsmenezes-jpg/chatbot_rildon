# Servidor
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb

# CORS: liste TODAS as URLs usadas para abrir o painel, separadas por
# vírgula — inclui acesso local (localhost), IP da rede local (ex: outros
# computadores acessando por http://192.168.x.x:3000) e/ou domínio real
# em produção. Falta uma URL aqui e o Socket.IO (tempo real do painel)
# quebra silenciosamente só naquele computador/endereço, mesmo a API
# funcionando normalmente (ver comentário em src/services/socket.service.js).
# Exemplo: CORS_ORIGIN=https://painel.suaempresa.com.br,http://192.168.0.10:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CSP_CONNECT_SRC='self'

# Segurança
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=troque_por_um_token_com_64_caracteres_ou_mais
JWT_SECRET=
SESSION_TTL_MINUTES=30

# MCP somente-leitura (nova função, 2026-09-09) — desligado por padrão.
# Ligue só se for plugar um Claude Code/Desktop LOCAL em
# http://localhost:PORT/api/mcp. Não afeta o atendimento automático nem
# expõe nada sem esse opt-in — ver src/services/mcp.service.js.
MCP_ENABLED=false
# Token PRÓPRIO do MCP — de propósito DIFERENTE do API_TOKEN acima. O
# API_TOKEN também autentica rotas que enviam mensagem/mexem em ticket (ver
# authSession em src/routes/auth.routes.js); as tools do MCP são só leitura,
# então usar um token à parte garante que, se ESTE vazar (ele fica salvo no
# .mcp.json da sua máquina), quem pegar não ganha mais acesso do que as
# tools já dão. Gere com o mesmo comando do API_TOKEN acima — nunca reuse o
# mesmo valor dos dois.
MCP_API_TOKEN=troque_por_um_token_com_64_caracteres_ou_mais
# Limite de chamadas/min só pra /api/mcp (além do limite geral do painel,
# API_RATE_LIMIT_MAX abaixo) — uma pergunta em linguagem natural pro Claude
# local pode virar várias tool calls em sequência rápida.
MCP_RATE_LIMIT_MAX=30

# COOKIE_SECURE: deixe "false" (padrão) se o painel é acessado por HTTP puro
# (ex: rede local, IP tipo 192.168.x.x, sem certificado). Só mude para "true"
# se este servidor estiver de fato atrás de HTTPS (proxy reverso com TLS) —
# do contrário o navegador descarta o cookie de sessão em qualquer endereço
# que não seja "localhost", e o login fica "expirando" a cada requisição.
COOKIE_SECURE=false

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque_esta_senha
DB_NAME=chatbot_rildon
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# IA / Chatbot (src/services/ai.service.js)
# Provedor ativo: "groq" (padrão, grátis), "gemini" (grátis) ou "anthropic"
# (Claude — pago, melhor qualidade de resposta e classificação de intenção).
AI_PROVIDER=groq
GROQ_API_KEY=cole_sua_chave_aqui
GEMINI_API_KEY=cole_sua_chave_aqui
# Gere em console.anthropic.com → API Keys. Só necessária se AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=cole_sua_chave_aqui

# WhatsApp / Atendimento
# Apenas números, sem +, espaços ou traços. Exemplo: 5579999999999
ATENDENTE_NUMBER=5579999999999

# Modo restrito: cada atendente só vê/gerencia tickets que assumiu +
# tickets ainda livres no seu próprio setor. Com "true", todo atendente
# enxerga e pode agir em qualquer ticket, como um admin (útil pra equipes
# pequenas onde todo mundo cobre todo mundo).
ATTENDANT_CONVERSATIONS_FULL_ACCESS=false

# Regras de negócio
TZ_NEGOCIO=America/Maceio
AVISO_MINUTOS=3
TIMEOUT_MINUTOS=5
SESSION_TTL_HORAS=24

# Tempo máximo (ms) que o bot espera pra processar uma mensagem antes de
# desistir e mandar BOT_PROCESSING_FALLBACK — evita o cliente ficar sem
# resposta nenhuma se a IA ou o banco travarem momentaneamente.
BOT_MESSAGE_TIMEOUT_MS=45000
# Mensagens de fallback (opcionais — já têm um texto padrão embutido no
# código se deixar em branco):
# BOT_PROCESSING_FALLBACK: quando o processamento da mensagem estoura o
# timeout acima.
# BOT_FLOW_FALLBACK: quando um erro inesperado interrompe o fluxo de
# conversa (nome/veículo/peça etc).
# BOT_PROCESSING_FALLBACK=
# BOT_FLOW_FALLBACK=

# Quanto tempo (minutos) o bot fica pausado pra um cliente depois que um
# atendente assume a conversa (modo humano) — depois disso, volta a
# responder automaticamente se ninguém mais interagir.
HUMAN_MODE_TTL_MIN=30

# Janela (horas) em que a resposta a uma pesquisa de satisfação enviada ao
# fechar um ticket ainda é aceita — depois disso, uma mensagem do cliente
# não é mais tratada como nota (1-5), só como conversa normal.
SATISFACTION_SURVEY_WINDOW_HOURS=48

# Ticket fechado que recebe mensagem de novo do cliente: reabre o MESMO
# ticket só se fechou há menos desses minutos (cobre reconexao rapida,
# ex: atendimento encerrado por timeout de inatividade e cliente responde
# na sequencia). Fora dessa janela, um ticket NOVO e criado quando o
# cliente pedir algo — evita reciclar um protocolo antigo pra um assunto
# sem relacao, dias/semanas depois.
TICKET_REOPEN_WINDOW_MINUTOS=240

# Monitoramento de erros (Sentry) — OPCIONAL. Sem SENTRY_DSN, fica desativado.
# Crie um projeto Node em sentry.io e cole o DSN abaixo.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=chatbot-rildon@1.0.0

# Rate limit / entrada
MAX_CHARS_INPUT=500
RATE_LIMIT_MAX=10
RATE_LIMIT_JANELA_MS=10000
API_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
MESSAGE_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=30
CRITICAL_ACTION_RATE_LIMIT_MAX=10

# Backups e logs
MAX_BACKUPS=30
LOG_LEVEL=info
MAX_LOG_SIZE_MB=10

# Backup do banco (scripts/backup.sh e scripts/restore.sh) — NÃO usadas pelo
# servidor Node, só pelos scripts de backup/restauração (rodados via cron ou manualmente).
# BACKUP_ENCRYPTION_KEY: obrigatória p/ backup.sh. Gere com: openssl rand -base64 48
BACKUP_ENCRYPTION_KEY=
# BACKUP_REMOTE: opcional. Destino rclone p/ envio off-site do dump cifrado.
# Exemplo: BACKUP_REMOTE=s3remote:meu-bucket/rildon-backups
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=14

# Painel Fotos X2 — Rotinas (scripts/x2-painel/) — OPCIONAL, só necessário se
# você configurar uma Rotina automática (baixar fotos/sync de produtos numa
# hora agendada, sem ninguém na frente do computador). O X2 tem timeout de
# sessão, então uma rotina precisa logar sozinha a cada execução — sem essas
# duas variáveis, uma rotina agendada falha com erro claro (fica registrado
# no painel), em vez de travar esperando um clique que nunca vem.
# ⚠️ Login automático ainda não foi confirmado numa sessão real do X2 — a
# 1ª rotina configurada deve ser observada rodando pelo menos uma vez.
X2_USUARIO=
X2_SENHA=

# Número de WhatsApp (com DDI+DDD, só dígitos ou com +/espaço/traço — tanto
# faz) que recebe os alertas automáticos de "Cortes de Produtos" (estoque
# baixo) e "Produtos Parados" (Curva ABC), disparados pelas Rotinas do
# Painel X2 através do bot Rildon (ver scripts/x2-whatsapp-alerta.js).
# 2026-08-10: número de TESTE combinado com o usuário.
ALERTA_WHATSAPP_NUMERO=5579918000035

# Upload automático de catálogo (PDF por fabricante) pro Google Drive —
# PEDIDO DO USUÁRIO (2026-09-11) — 3º elo do encadeamento automático pós-
# Lançamentos (ver scripts/x2-drive-lancamentos.js). OPCIONAL: sem essas
# variáveis, o cadastro e as fotos continuam rodando normalmente, só o
# upload pro Drive fica pendente (aviso claro no log, nada quebra).
#
# Autenticação via OAuth (NÃO conta de serviço — uma conta de serviço não
# tem cota própria em pasta de Gmail pessoal, só funciona com Drive
# Compartilhado, recurso exclusivo de Google Workspace; tentado e descartado
# em 2026-09-16 com o erro "Service Accounts do not have storage quota").
#
# Como configurar:
#   1. console.cloud.google.com → crie um projeto (ou use um já existente).
#   2. "APIs e serviços" → "Biblioteca" → ative a "Google Drive API".
#   3. "APIs e serviços" → "Tela de consentimento OAuth" → tipo "Externo" →
#      preencha nome do app/e-mail → em "Usuários de teste" adicione a conta
#      Google DONA da pasta do Drive (evita a tela "app não verificado"
#      bloquear o login).
#   4. "APIs e serviços" → "Credenciais" → "Criar credenciais" → "ID do
#      cliente OAuth" → tipo de aplicativo "App para computador" → dê um
#      nome (ex: "rildon-catalogo-drive") → crie.
#   5. Copie o "Client ID" e o "Client secret" mostrados → preencha
#      GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET abaixo.
#   6. Preencha GOOGLE_DRIVE_PASTA_LANCAMENTOS_ID com o ID da pasta do Drive
#      onde os catálogos devem ser salvos (o ID é o trecho depois de
#      /folders/ no link da pasta) — a pasta só precisa existir na MESMA
#      conta Google que vai autorizar no passo seguinte, não precisa
#      compartilhar com ninguém.
#   7. Rode `node scripts/x2-drive-oauth-setup.js` — o script mostra um link,
#      abra no navegador, faça login com a conta Google dona da pasta,
#      autorize, e cole de volta o código que o Google mostrar na tela. Isso
#      salva o token em GOOGLE_DRIVE_OAUTH_TOKEN_PATH — passo único (só
#      precisa repetir se o acesso for revogado).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_TOKEN_PATH=credentials/google-drive-oauth-token.json
GOOGLE_DRIVE_PASTA_LANCAMENTOS_ID=
