# Servidor
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb

# CORS: liste TODAS as URLs usadas para abrir o painel, separadas por
# vírgula — inclui acesso local (localhost), IP da rede local (ex: outros
# computadores acessando por http://192.168.x.x:3000) e/ou domínio real
# em produção. Falta uma URL aqui e o Socket.IO (tempo real do painel)
# quebra silenciosamente só naquele computador/endereço, mesmo a API
# funcionando normalmente (ver comentário em src/services/socket.service.js).
# Exemplo: CORS_ORIGIN=https://painel.suaempresa.com.br,http://192.168.0.10:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CSP_CONNECT_SRC='self'

# Segurança
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=troque_por_um_token_com_64_caracteres_ou_mais
JWT_SECRET=
SESSION_TTL_MINUTES=30

# COOKIE_SECURE: deixe "false" (padrão) se o painel é acessado por HTTP puro
# (ex: rede local, IP tipo 192.168.x.x, sem certificado). Só mude para "true"
# se este servidor estiver de fato atrás de HTTPS (proxy reverso com TLS) —
# do contrário o navegador descarta o cookie de sessão em qualquer endereço
# que não seja "localhost", e o login fica "expirando" a cada requisição.
COOKIE_SECURE=false

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque_esta_senha
DB_NAME=chatbot_rildon
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# WhatsApp / Atendimento
# Apenas números, sem +, espaços ou traços. Exemplo: 5579999999999
ATENDENTE_NUMBER=5579999999999

# Regras de negócio
TZ_NEGOCIO=America/Maceio
AVISO_MINUTOS=3
TIMEOUT_MINUTOS=5
SESSION_TTL_HORAS=24

# Monitoramento de erros (Sentry) — OPCIONAL. Sem SENTRY_DSN, fica desativado.
# Crie um projeto Node em sentry.io e cole o DSN abaixo.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=chatbot-rildon@1.0.0

# Rate limit / entrada
MAX_CHARS_INPUT=500
RATE_LIMIT_MAX=10
RATE_LIMIT_JANELA_MS=10000
API_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
MESSAGE_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=30
CRITICAL_ACTION_RATE_LIMIT_MAX=10

# Backups e logs
MAX_BACKUPS=30
LOG_LEVEL=info
MAX_LOG_SIZE_MB=10

# Backup do banco (scripts/backup.sh e scripts/restore.sh) — NÃO usadas pelo
# servidor Node, só pelos scripts de backup/restauração (rodados via cron ou manualmente).
# BACKUP_ENCRYPTION_KEY: obrigatória p/ backup.sh. Gere com: openssl rand -base64 48
BACKUP_ENCRYPTION_KEY=
# BACKUP_REMOTE: opcional. Destino rclone p/ envio off-site do dump cifrado.
# Exemplo: BACKUP_REMOTE=s3remote:meu-bucket/rildon-backups
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=14
