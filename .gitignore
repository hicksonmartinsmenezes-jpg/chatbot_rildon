# Ambiente
.env
.env.*
!.env.example

# Dependências
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
logs/
*.log
src/logs/*
!src/logs/.gitkeep

# Dados locais / fallback JSON
src/data/*
!src/data/.gitkeep
src/services/data/

# Uploads gerados em runtime
uploads/
src/uploads/*
!src/uploads/.gitkeep
!src/uploads/campaigns/
!src/uploads/campaigns/.gitkeep
!src/uploads/profile/
!src/uploads/profile/.gitkeep
!src/uploads/profiles/
!src/uploads/profiles/.gitkeep
src/services/uploads/

# Mídia recebida de clientes (foto/áudio/vídeo/documento) — ver migration
# 017. Fica FORA de src/uploads/ (que é público) de propósito; não deve ir
# pro git de qualquer forma, é conversa privada do cliente.
src/media-recebida/*
!src/media-recebida/.gitkeep

# Sessões e credenciais do WhatsApp/Baileys
auth_info/
.auth/
auth/
sessions/
baileys_auth/
*.session
*.creds.json

# Conta de serviço do Google (upload automático de catálogo pro Drive,
# ver scripts/x2-drive-lancamentos.js e .env GOOGLE_DRIVE_CREDENCIAIS_PATH)
credentials/

# Build / cache / sistema operacional
coverage/
dist/
build/
.cache/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Arquivos compactados / backups acidentais
*.zip
src.zip

# Dumps de backup do banco (gerados por scripts/backup.sh)
backups/
*.sql.gz

# Geradores do Playbook de Tráfego Pago (projeto separado — não pertence ao chatbot)
gerar_volume*.js
gerar_volume*.py

# Configuração local do assistente / arquivos pessoais soltos na pasta do projeto
.claude/
fotos/

# Banco de dados do catálogo X2 (dados + fotos extraídos do ERP em
# 2026-07-20, ver catalogo-x2.service.js/catalogo-fotos.service.js) — ~157MB,
# decisão do usuário (2026-07-24): fica só local, como uploads/media já
# ficam. Pra rodar em outro lugar, copiar esta pasta manualmente antes de
# iniciar o servidor (senão o painel "Catálogo de Produtos" e a busca por
# veículo/código do bot ficam sem dado nenhum pra indexar).
src/config/catalogo-x2/

# Documentos/relatorios do projeto (nao sao codigo, organizados fora do repo)
documentos-projeto/

# Dumps de banco soltos na raiz do projeto (contem dados pessoais de clientes,
# LGPD) e sessoes antigas do WhatsApp renomeadas. Regra restrita a raiz (/*.sql)
# de proposito: NAO usar "*.sql" solto, senao migrations novas em
# src/database/migrations/ deixam de ser detectadas pelo git.
/*.sql
auth_info*/

# Saidas soltas de ferramentas/anotacoes locais (nao sao codigo)
Claude outputs/
*.restore-note

# Dados pessoais de contatos ficam somente no ambiente local
/contatos/*
!/contatos/README.md

# Configuracao local do Maestri (nao versionar)
.maestri/
