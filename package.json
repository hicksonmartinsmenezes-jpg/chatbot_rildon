{
  "name": "chatbot-rildon-backend",
  "version": "1.0.0",
  "description": "Backend do painel de atendimento e chatbot Rildon.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/database/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "merge-contacts": "node scripts/merge-duplicate-contacts.js",
    "bulk-tag-contacts": "node scripts/bulk-tag-contacts.js",
    "testar-ia-midia": "node scripts/testar-ia-midia.js",
    "db:test": "node src/database/test-postgres.js",
    "check": "node -c src/server.js && node -c src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:flow": "node test-flow.js",
    "build:frontend": "node scripts/build-frontend.js",
    "x2-fotos": "node scripts/x2-fotos-scraper.js",
    "x2-fotos-menu": "node scripts/x2-fotos-menu.js",
    "x2-catalogo-sync": "node scripts/x2-catalogo-sync.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@sentry/node": "^10.63.0",
    "@whiskeysockets/baileys": "^6.7.23",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "otplib": "^12.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.21.0",
    "pino": "^8.21.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.48.0",
    "prettier": "^3.9.4",
    "prompts": "^2.4.2",
    "supertest": "^7.2.2"
  }
}
