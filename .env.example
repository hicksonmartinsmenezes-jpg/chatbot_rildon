# ─── Servidor ─────────────────────────────────────────────────
PORT=3000

# ─── WhatsApp ──────────────────────────────────────────────────
# Número do atendente que recebe notificações de novos tickets
# Formato: código do país + DDD + número (sem + nem espaços)
ATENDENTE_NUMBER=5579999999999

# ─── Segurança ─────────────────────────────────────────────────
# Token de autenticação da API externa. DEVE ser trocado antes de ir a produção!
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=troque-por-um-token-seguro-aqui

# Segredo do JWT (usado para autenticação do painel). Mínimo 32 caracteres.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=coloque-um-segredo-longo-e-aleatorio-aqui

# ─── Timezone e Horários ───────────────────────────────────────
# Timezone do negócio. Utilizado em horario.js e notificacao.service.js
TZ_NEGOCIO=America/Maceio

# Minutos antes de encerrar sessão por inatividade para enviar aviso
AVISO_MINUTOS=3
# Minutos totais de inatividade antes de encerrar a sessão
TIMEOUT_MINUTOS=5
# TTL (horas) das sessões de conversação salvas no banco
SESSION_TTL_HORAS=24

# ─── Rate Limit (bot WhatsApp) ─────────────────────────────────
MAX_CHARS_INPUT=500
RATE_LIMIT_MAX=10
RATE_LIMIT_JANELA_MS=10000

# ─── Backups ───────────────────────────────────────────────────
# Quantidade máxima de pastas de backup retidas (as mais antigas são apagadas)
MAX_BACKUPS=30

# ─── Banco de Dados (PostgreSQL) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque-uma-senha-forte-aqui
DB_NAME=chatbot_rildon
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# ─── Logs ──────────────────────────────────────────────────────
# Nível mínimo: success | info | warn | error
LOG_LEVEL=info
# Tamanho máximo de cada arquivo de log antes de rotacionar (MB)
MAX_LOG_SIZE_MB=10

# ─── CSP (Content Security Policy) ────────────────────────────
# Origens permitidas para o frontend (separadas por vírgula, ou * para tudo em dev)
# Ex: https://meudominio.com,https://painel.meudominio.com
CSP_CONNECT_SRC=*
