PORT=3000
ATENDENTE_NUMBER=557999999999

# ── Credenciais do painel web ──────────────────────────────────────────────────
# Troque ANTES de colocar em produção
# Gere uma senha forte: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-por-senha-forte-aqui

# Token fixo para integrações externas (opcional)
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=troque-por-um-token-seguro-aqui

# ── Timezone e horários ────────────────────────────────────────────────────────
TZ_NEGOCIO=America/Maceio
AVISO_MINUTOS=3
TIMEOUT_MINUTOS=5

# ── Limites ────────────────────────────────────────────────────────────────────
MAX_CHARS_INPUT=500
RATE_LIMIT_MAX=10
RATE_LIMIT_JANELA_MS=10000
