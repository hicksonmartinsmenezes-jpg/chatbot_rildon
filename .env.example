PORT=3000
ATENDENTE_NUMBER=557999999999

# ── Credenciais do painel web ──────────────────────────────────────────────────
# Gere senhas fortes antes de ir para produção:
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-por-senha-forte-aqui

# Token para integrações externas
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=troque-por-um-token-seguro-aqui

# ── Banco de dados PostgreSQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-pela-senha-do-postgres
DB_NAME=chatbot_rildon
# Conexões simultâneas no pool (recomendado: 5-10)
DB_POOL_MAX=10
# Timeout para conseguir conexão do pool (ms)
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# ── Timezone e horários ────────────────────────────────────────────────────────
TZ_NEGOCIO=America/Maceio
AVISO_MINUTOS=3
TIMEOUT_MINUTOS=5

# ── Limites ────────────────────────────────────────────────────────────────────
MAX_CHARS_INPUT=500
RATE_LIMIT_MAX=10
RATE_LIMIT_JANELA_MS=10000

# ── Sessões WhatsApp ───────────────────────────────────────────────────────────
# Tempo máximo de inatividade de sessão no banco (horas)
SESSION_TTL_HORAS=24
